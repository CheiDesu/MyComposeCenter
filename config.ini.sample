# =============================================================================
# ccenter 配置文件（自动生成）。改完保存即可，下次运行时生效。
# 格式：键=值；以 # 开头的是注释，可以整行删除。
# =============================================================================

# 备份根目录：快照、日志、索引都放在这里。默认 = 脚本所在目录；也可换成独立磁盘路径。
root=/opt/ccenter

# 自动备份开关：1=开启，0=关闭（仅影响定时任务，手动备份不受影响）。
auto_enabled=1

# 自动备份间隔（小时）。例如 12 = 每 12 小时一次。
auto_interval=12

# 快照总容量上限，支持 K/M/G/T（如 10G）。超过后从最旧的开始删，但至少保留 min_keep 份。
max_size=10G

# 至少保留的快照份数（无论容量是否超限）。
min_keep=2

# 压缩方式：zstd（快、体积小，推荐）| gzip（无 zstd 时用）。
compress=zstd

# 一致性模式：online=不停容器直接打包（快，但可能抓到写了一半的文件）
#             quiesced=备份前短暂 stop 容器、备份后 start（一致性好，会中断几秒）
#             ask=每次手动备份时询问
consistency=quiesced

# 是否把 bind mount 的本地目录一起打进快照：0=不（推荐，目录请单独备份），1=是。
include_bind=0

# 是否用 docker save 把镜像也存进快照：0=不（推荐），1=是（每份多几百 MB~GB）。
include_images=0

# 自动备份包含哪些项目：all=全部 compose 项目；也可写逗号分隔的项目名（如 blog,db）。
auto_projects=all

# 保留策略：recent=超限时删最旧的；daily=每个项目每天只保留最新一份。
retention=recent

# 「校验/导出」的默认导出目录；留空 = <root>/export。
export_target=
